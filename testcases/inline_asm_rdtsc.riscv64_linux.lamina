# The time counter is read twice with a delay between; it must not go backwards
fn @main() -> i64 {
entry:
  %a = asm.i64 "rdtime $0", out(reg)
  %b = asm.i64 "li t3, 2000\n1: addi t3, t3, -1\nbnez t3, 1b\nrdtime $0", out(reg), clobber(t3)
  %d = sub.i64 %b, %a
  %ok = gt.i64 %d, 0
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %n = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %n2 = writebyte 10
  ret.i64 1
}

# An atomic result stays live across a later atomic: the registers an atomic takes
# as scratch must not be the ones holding values the code still needs.
fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
fn @main() -> i64 {
entry:
  %p = stackalloc.i32
  store.i32 %p, 100
  %a = atomic_add.i32 %p, 23, seqcst
  %b = atomic_load.i32 %p, seqcst
  %c = atomic_xor.i32 %p, 7, acqrel
  %d = atomic_exchange.i32 %p, 55, seqcst
  %e = atomic_cmpxchg.i32 %p, 55, 99, seqcst, seqcst
  %f = atomic_load.i32 %p, acquire
  %a64 = extend.i32.i64 %a
  %b64 = extend.i32.i64 %b
  %c64 = extend.i32.i64 %c
  %d64 = extend.i32.i64 %d
  %e64 = extend.i32.i64 %e
  %f64 = extend.i32.i64 %f
  call @print_i64(%a64)
  call @print_i64(%b64)
  call @print_i64(%c64)
  call @print_i64(%d64)
  call @print_i64(%e64)
  call @print_i64(%f64)
  ret.i64 0
}

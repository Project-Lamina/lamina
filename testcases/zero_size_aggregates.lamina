# Zero-size structs and arrays cross calls without taking a register or a copy: as
# parameters, as results, through an indirect call, and beside scalars whose
# register positions must not shift.

type !Empty = struct {}
type !Holder = struct { e: !Empty }
type !Nothing = [0 x i32]

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @make_empty() -> !Empty {
entry:
  %e = stackalloc.!Empty
  ret.!Empty %e
}

fn @pass(!Empty %e) -> !Empty {
entry:
  ret.!Empty %e
}

fn @mixed(!Empty %e, i64 %a, !Holder %h, i64 %b, !Nothing %z, i64 %c, i64 %d, i64 %f, i64 %g) -> i64 {
entry:
  %s1 = add.i64 %a, %b
  %s2 = add.i64 %s1, %c
  %s3 = add.i64 %s2, %d
  %s4 = add.i64 %s3, %f
  %s5 = add.i64 %s4, %g
  ret.i64 %s5
}

fn @make_nothing(i64 %x) -> !Nothing {
entry:
  %z = stackalloc.!Nothing
  ret.!Nothing %z
}

fn @main() -> i64 {
entry:
  %e = call @make_empty()
  %r = call @pass(!Empty %e)
  %h = stackalloc.!Holder
  %z = call @make_nothing(7)
  %sum = call @mixed(!Empty %r, 1, !Holder %h, 2, !Nothing %z, 3, 4, 5, 6)
  call @print_i64(%sum)
  %p = funcaddr @mixed
  %q = funcaddr @pass
  %mk = funcaddr @make_empty
  %re = callptr.!Empty %q()
  %ind = callptr.i64 %p(!Empty %re, i64 10, !Holder %h, i64 20, !Nothing %z, i64 30, i64 40, i64 50, i64 60)
  call @print_i64(%ind)
  ret.i64 0
}

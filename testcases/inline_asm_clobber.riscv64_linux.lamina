# A callee clobbers s2 and s3 and must restore them; a value live across the call survives
fn @clobber() -> i64 {
entry:
  asm.void "li s2, 99\nli s3, 98", clobber(s2, s3)
  ret.i64 7
}

fn @main() -> i64 {
entry:
  %a = add.i64 40, 0
  %c = call @clobber()
  %s = add.i64 %a, %c
  asm.void "li s2, 77", clobber(s2)
  %t = add.i64 %s, 0
  %ok = eq.i64 %t, 47
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %nl = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %nl2 = writebyte 10
  ret.i64 1
}
